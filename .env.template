# Copy this file to /opt/lms-system/.env and replace all CHANGE_ME values.
# Never commit the completed .env file.
SECRET_KEY=CHANGE_ME_GENERATE_USING_DJANGO_GET_RANDOM_SECRET_KEY
DEBUG=False
# Comma-separated IPs / domains. Keep localhost/127.0.0.1 for container healthcheck.
ALLOWED_HOSTS=CHANGE_ME_SERVER_IP_OR_DOMAIN,localhost,127.0.0.1
# Include scheme (http:// or https://), comma-separated.
CSRF_TRUSTED_ORIGINS=http://CHANGE_ME_SERVER_IP_OR_DOMAIN

# Both groups MUST match (Postgres service credentials and Django connection).
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DB_NAME=lms
DB_USER=lms
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DB_HOST=db
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional integration: set an actual Stripe key only when needed.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=rub
STRIPE_SUCCESS_URL=http://CHANGE_ME_SERVER_IP_OR_DOMAIN/api/docs/
STRIPE_CANCEL_URL=http://CHANGE_ME_SERVER_IP_OR_DOMAIN/api/docs/

# Use console backend for demonstration; configure SMTP separately for real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
